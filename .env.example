# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS…)
DATABASE_URL="postgresql://postgres@localhost:5432/oflinewave?schema=public"

# Public base URL, no trailing slash. Used in emails, QR image links, OG tags.
APP_URL="http://localhost:3000"

# Auth.js secret. Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Signs ticket QR codes (HMAC). 32+ random chars. NEVER change after tickets
# are issued: existing QR codes stop scanning.
TICKET_SIGNING_SECRET=""

# This email becomes SUPER_ADMIN on sign-in (bootstrap the first admin).
SUPER_ADMIN_EMAIL=""

# ─── Payments: Paystack ──────────────────────────────────────────────────────
# Without this key, dev uses a built-in payment simulator at /dev/pay.
# Production REQUIRES it. Use sk_test_… on staging, sk_live_… in production.
PAYSTACK_SECRET_KEY=""

# ─── Email: Resend ───────────────────────────────────────────────────────────
# Without a key, dev prints emails (incl. sign-in links) to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Oflinewave <tickets@oflinewave.com>"

# ─── Optional ────────────────────────────────────────────────────────────────
# Google sign-in. Button appears only when both are set.
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob for poster uploads. Without it, uploads are saved to disk in UPLOAD_DIR
# (fine on cPanel or a VPS; not on Vercel, where the disk is wiped).
BLOB_READ_WRITE_TOKEN=""
# Folder for uploaded posters when Blob isn't used. Put it OUTSIDE the app folder so
# a redeploy doesn't delete them, e.g. /home/youruser/oflinewave_uploads. Default: ./uploads
UPLOAD_DIR=""

# ─── Error monitoring: Sentry (optional, recommended in production) ─────────
# Off until the DSN is set. Auth token enables source-map upload at build time.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Page analytics: Plausible (optional) ───────────────────────────────────
# The ticket funnel (views → checkout → paid) is built in and needs nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── Add to wallet (optional; buttons appear only when configured) ─────────
# Google Wallet: issuer ID from the Google Pay & Wallet Console, plus a service
# account with the Wallet Object Issuer role. Private key: PEM or base64 PEM.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# Apple Wallet: needs an Apple Developer account and a Pass Type ID certificate.
# Values are PEM text (or base64 of the PEM).
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""
